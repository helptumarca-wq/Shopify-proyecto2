>\n  </div>\n</div>\n\n<style>\n@keyframes marquee-fotos {\n  0%   { transform: translateX(0); }\n  100% { transform: translateX(-50%); }\n}\n\n.reviews-section {\n  padding: 3rem 0;\n  text-align: center;\n}\n\n.reviews-title {\n  font-size: 2rem;\n  margin-bottom: 2rem;\n}\n\n.reviews-slider {\n  overflow: hidden;\n  position: relative;\n  width: 100%;\n}\n\n.reviews-fade {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 80px;\n  z-index: 2;\n  pointer-events: none;\n}\n\n.fade-left {\n  left: 0;\n  background: linear-gradient(to right, #fff, transparent);\n}\n\n.fade-right {\n  right: 0;\n  background: linear-gradient(to left, #fff, transparent);\n}\n\n.reviews-track {\n  display: flex;\n  gap: 2rem;\n  width: max-content;\n  animation: marquee-fotos 30s linear infinite;\n}\n\n.reviews-track:hover {\n  animation-play-state: paused;\n}\n\n.review-card {\n  flex: 0 0 320px;\n  height: 420px;\n  position: relative;\n  border-radius: 16px;\n  overflow: hidden;\n  cursor: pointer;\n}\n\n.review-card img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.review-overlay {\n  position: absolute;\n  bottom: 0;\n  width: 100%;\n  padding: 1rem;\n  background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);\n  color: #fff;\n}\n\n.review-full {\n  position: absolute;\n  bottom: -100%;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0,0,0,0.9);\n  color: #fff;\n  padding: 1.5rem;\n  transition: 0.4s;\n  display: flex;\n  align-items: center;\n  box-sizing: border-box;\n}\n\n.review-card:hover .review-full {\n  bottom: 0;\n}\n\n.reviews-cta {\n  text-align: center;\n  padding: 2rem 0;\n}\n\n.cta-actions {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 2rem;\n  flex-wrap: wrap;\n}\n\n.reviews-cta .btn {\n  display: inline-block;\n  background: #1a1a2e;\n  color: #fff;\n  font-weight: 700;\n  text-decoration: none;\n  padding: 1.6rem 3.8rem;\n  border-radius: 50px;\n  font-size: 1.7rem;\n  letter-spacing: 1px;\n  transition: all 0.3s ease;\n}\n\n.reviews-cta .btn:hover {\n  background: #000;\n  transform: translateY(-2px);\n}\n\n.rating-block {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n}\n\n.rating-block .stars {\n  color: #f4b942;\n  font-size: 1.8rem;\n}\n\n.rating-block .score {\n  font-size: 1.1rem;\n  color: #555;\n}\n</style>",
