      "settings": {
        "custom_liquid": "<div class=\"comparison-section\">\n  <div class=\"text-side\">\n    <h2>Resultados visibles desde el primer uso</h2>\n    <p>\n      Descubre la diferencia con un cambio real y al instante. Mejora la apariencia y consigue un acabado más cuidado y profesional sin complicaciones ✨\n    </p>\n  </div>\n\n  <div class=\"image-side\">\n    <div class=\"compare-wrapper\" id=\"compareWrapper\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0967/8281/1469/files/1_c1b985db-3236-46cb-8a8d-162d955f81a1.png?v=1777731678\" class=\"before\" id=\"beforeImg\" alt=\"Imagen antes del resultado\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0967/8281/1469/files/2_3c7e731f-e122-451f-aa01-533eb1260b40.png?v=1777731681\" class=\"after\" id=\"afterImg\" alt=\"Imagen después del resultado\">\n      <div class=\"divider\" id=\"divider\"><span>⮜ DESLIZA ⮞</span></div>\n\n      <!-- Etiquetas -->\n      <div class=\"corner-label left\">ANTES</div>\n      <div class=\"corner-label right\">DESPUÉS</div>\n    </div>\n  </div>\n</div>\n\n<style>\n.comparison-section {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 3rem;\n  padding: 5rem 2rem;\n  background: #fff;\n  font-family: \"Poppins\", sans-serif;\n  color: #2E2A39;\n}\n\n.text-side {\n  flex: 1;\n  max-width: 520px;\n}\n.text-side h2 {\n  font-size: 2.6rem;\n  font-weight: 700;\n  line-height: 1.2;\n  margin-bottom: 1rem;\n}\n.text-side p {\n  font-size: 1.5rem;\n  line-height: 1.8;\n  color: #444;\n}\n\n.image-side {\n  flex: 1;\n  max-width: 520px;\n  display: flex;\n  justify-content: center;\n  width: 100%;\n}\n\n/* --- COMPARADOR --- */\n.compare-wrapper {\n  position: relative;\n  width: 100%;\n  max-width: 520px;\n  aspect-ratio: 3/4;\n  overflow: hidden;\n  border-radius: 16px;\n  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);\n  cursor: ew-resize;\n  user-select: none;\n  touch-action: none;\n  background: #f8f8f8;\n}\n\n.compare-wrapper img {\n  position: absolute;\n  top: 0;\n  left: 0;\n  height: 100%;\n  width: 100%;\n  object-fit: cover;\n  pointer-events: none;\n  display: block;\n}\n\n.compare-wrapper img.before {\n  clip-path: polygon(50% 0, 100% 0, 100% 100%, 50% 100%);\n}\n.compare-wrapper img.after {\n  clip-path: polygon(0 0, 50% 0, 50% 100%, 0 100%);\n}\n\n.divider {\n  position: absolute;\n  top: 0;\n  left: 50%;\n  width: 2px;\n  height: 100%;\n  background: #E65286;\n  transform: translateX(-1px);\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  pointer-events: none;\n}\n.divider span {\n  position: absolute;\n  bottom: 6%;\n  left: 50%;\n  transform: translate(-50%, 0);\n  background: #fff;\n  border: 2px solid #E65286;\n  color: #E65286;\n  font-weight: 600;\n  font-size: 0.85rem;\n  border-radius: 999px;\n  padding: 6px 16px;\n  white-space: nowrap;\n  box-shadow: 0 0 6px rgba(0,0,0,0.2);\n}\n\n/* Etiquetas esquina */\n.corner-label {\n  position: absolute;\n  top: 12px;\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: #fff;\n  background: rgba(0,0,0,0.4);\n  padding: 4px 12px;\n  border-radius: 6px;\n  backdrop-filter: blur(2px);\n  pointer-events: none;\n  user-select: none;\n}\n.corner-label.left { left: 12px; }\n.corner-label.right { right: 12px; }\n\n/* --- RESPONSIVE --- */\n@media (max-width: 900px) {\n  .comparison-section {\n    flex-direction: column;\n    text-align: center;\n    padding: 3rem 1.5rem;\n    gap: 2rem;\n  }\n  .text-side h2 { font-size: 1.9rem; }\n  .text-side p { font-size: 1.2rem; }\n  .image-side { max-width: 100%; width: 100%; }\n  .divider span { font-size: 0.75rem; padding: 4px 12px; bottom: 4%; }\n}\n</style>\n\n<script>\nconst wrapper = document.getElementById('compareWrapper');\nconst after = document.getElementById('afterImg');\nconst before = document.getElementById('beforeImg');\nconst divider = document.getElementById('divider');\nlet isDown = false;\nlet userInteracted = false;\n\nfunction moveSlider(x) {\n  const rect = wrapper.getBoundingClientRect();\n  let offset = x - rect.left;\n  offset = Math.max(0, Math.min(offset, rect.width));\n  const percent = (offset / rect.width) * 100;\n  after.style.clipPath = `polygon(0 0, ${percent}% 0, ${percent}% 100%, 0 100%)`;\n  before.style.clipPath = `polygon(${percent}% 0, 100% 0, 100% 100%, ${percent}% 100%)`;\n  divider.style.left = `${percent}%`;\n}\n\nfunction stopIdle() {\n  if (!userInteracted) {\n    userInteracted = true;\n  }\n}\n\n/* Desktop */\nwrapper.addEventListener('mousedown', e => { isDown = true; stopIdle(); moveSlider(e.clientX); });\nwrapper.addEventListener('mousemove', e => { if (isDown) moveSlider(e.clientX); });\nwindow.addEventListener('mouseup', () => isDown = false);\n\n/* Mobile */\nwrapper.addEventListener('touchstart', e => { isDown = true; stopIdle(); moveSlider(e.touches[0].clientX); e.preventDefault(); }, { passive: false });\nwrapper.addEventListener('touchmove', e => { if (isDown) moveSlider(e.touches[0].clientX); e.preventDefault(); }, { passive: false });\nwrapper.addEventListener('touchend', () => { isDown = false; });\n\n/* --- Animación ocasional aleatoria --- */\nfunction easeInOutSine(t) {\n  return -(Math.cos(Math.PI * t) - 1) / 2;\n}\n\nfunction animateHint() {\n  if (userInteracted) return;\n  const duration = 2000;\n  const start = 50;\n  const amplitude = 15;\n  let startTime = null;\n\n  function frame(time) {\n    if (!startTime) startTime = time;\n    const progress = (time - startTime) / duration;\n    const offset = amplitude * Math.sin(progress * Math.PI * 2);\n    const percent = start + offset;\n    const rect = wrapper.getBoundingClientRect();\n    moveSlider(rect.left + (rect.width * percent / 100));\n    if (progress < 1 && !userInteracted) {\n      requestAnimationFrame(frame);\n    }\n  }\n  requestAnimationFrame(frame);\n\n  const nextDelay = 2000 + Math.random() * 4000;\n  setTimeout(() => {\n    if (!userInteracted) animateHint();\n  }, nextDelay);\n}\n\nsetTimeout(animateHint, 2500);\n</script>",
